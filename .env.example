# Broker
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=saga.events

# PostgreSQL (una base por servicio dentro de la misma instancia)
POSTGRES_USER=saga
POSTGRES_PASSWORD=saga
POSTGRES_DB=saga

# URLs para ejecutar servicios con go run en el host (el compose las sobrescribe)
ORDER_DATABASE_URL=postgres://saga:saga@localhost:5433/orders?sslmode=disable
PAYMENT_DATABASE_URL=postgres://saga:saga@localhost:5433/payments?sslmode=disable
INVENTORY_DATABASE_URL=postgres://saga:saga@localhost:5433/inventory?sslmode=disable
SHIPPING_DATABASE_URL=postgres://saga:saga@localhost:5433/shipping?sslmode=disable

# Inyección de fallos para la demostración
FAIL_PAYMENT=false
FAIL_INVENTORY=false
FAIL_SHIPPING=false
MAX_PAYMENT_AMOUNT=1000
BLOCKED_CUSTOMER=blocked

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
